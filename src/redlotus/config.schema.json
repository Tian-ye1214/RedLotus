{
  "type": "object",
  "description": "RedLotus 公开字段契约；不包含配置值、模型选择、凭据或策略默认值",
  "properties": {
    "models": {
      "type": "object",
      "description": "当前内置能力需要的模型配置；可增加任意新身份，运行时按本配置枚举",
      "properties": {
        "coordinator": {
          "$ref": "#/$defs/context_model"
        },
        "manager": {
          "$ref": "#/$defs/context_model"
        },
        "worker": {
          "$ref": "#/$defs/context_model"
        },
        "compressor": {
          "$ref": "#/$defs/model"
        },
        "title": {
          "$ref": "#/$defs/model"
        }
      },
      "required": [
        "coordinator",
        "manager",
        "worker",
        "compressor",
        "title"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "model_presets": {
      "type": "object",
      "description": "显式复用的模型预设",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "$ref": "#/$defs/model",
        "type": "object"
      }
    },
    "gateways": {
      "type": "object",
      "description": "命名网关",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "type": "object",
        "description": "网关连接",
        "properties": {
          "base_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "完整服务地址"
          },
          "api_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "服务凭据，输入隐藏"
          },
          "api_key_env": {
            "type": "string",
            "description": "配置或 .env 中保存凭据的字段名"
          },
          "timeout": {
            "type": "number",
            "description": "模型 HTTP 总超时秒数",
            "exclusiveMinimum": 0
          },
          "connect_timeout": {
            "type": "number",
            "description": "模型 HTTP 建连超时秒数",
            "exclusiveMinimum": 0
          },
          "input_limits": {
            "$ref": "#/$defs/input_limits"
          }
        },
        "required": []
      }
    },
    "BASE_URL": {
      "type": [
        "string",
        "null"
      ],
      "description": "默认模型服务的完整 http/https 地址"
    },
    "API_KEY": {
      "type": [
        "string",
        "null"
      ],
      "description": "默认模型服务凭据，输入隐藏"
    },
    "MODEL_HTTP_TIMEOUT": {
      "type": "number",
      "description": "模型 HTTP 总超时秒数",
      "exclusiveMinimum": 0
    },
    "request_limit": {
      "type": [
        "integer",
        "string",
        "null"
      ],
      "description": "单次 Agent 运行最多模型请求数；null 为不限",
      "minimum": 0,
      "allow_empty": true,
      "string_values": [
        "",
        "none",
        "unlimited",
        "null"
      ]
    },
    "agent_run_policy": {
      "type": "object",
      "description": "Agent 执行策略",
      "properties": {
        "max_concurrent_threads_per_session": {
          "type": "integer",
          "description": "同一会话子 Agent 并发线程上限",
          "minimum": 1
        },
        "max_command_timeout_seconds": {
          "type": "integer",
          "description": "工具命令允许的最长执行秒数",
          "minimum": 1
        },
        "max_task_retries": {
          "type": "integer",
          "minimum": 0,
          "description": "任务明确失败后的最大自动重试次数；0 表示不自动重试"
        }
      },
      "required": [
        "max_concurrent_threads_per_session",
        "max_command_timeout_seconds",
        "max_task_retries"
      ]
    },
    "lifecycle": {
      "type": "object",
      "description": "调用记录与退出策略",
      "properties": {
        "invocation_history_per_session": {
          "type": "integer",
          "description": "每个会话保留的调用记录数",
          "minimum": 1
        },
        "shutdown_grace_seconds": {
          "type": "number",
          "description": "取消与退出清理的期限秒数",
          "exclusiveMinimum": 0
        },
        "process_termination_timeout_seconds": {
          "type": "number",
          "description": "进程树终止和继承管道回收各阶段的最长等待秒数，整体退出仍受 shutdown_grace_seconds 约束",
          "exclusiveMinimum": 0
        },
        "trace_history_turns": {
          "type": "integer",
          "minimum": 1,
          "description": "进程内工具轨迹最多保留的回合数，不替代正式会话记录"
        }
      },
      "required": [
        "invocation_history_per_session",
        "shutdown_grace_seconds",
        "process_termination_timeout_seconds",
        "trace_history_turns"
      ]
    },
    "storage": {
      "type": "object",
      "description": "路径和磁盘清理策略",
      "properties": {
        "filename_max_chars": {"type": "integer", "minimum": 1, "description": "任务产物目录名和会话日志名的清洗长度；修改会影响新生成名称"},
        "file_lock_timeout_seconds": {
          "type": "number",
          "minimum": 0,
          "description": "跨进程文件锁最多等待秒数；0 表示不等待，首次配置提交使用本次填写值"
        },
        "project_dir": {
          "type": "string",
          "description": "项目数据目录，必须在当前项目内"
        },
        "sessions_dir": {
          "type": "string",
          "description": "会话目录，必须在当前项目内"
        },
        "project_logs_dir": {
          "type": "string",
          "description": "日志目录，必须在当前项目内"
        },
        "references_dir": {
          "type": "string",
          "description": "引用快照目录，必须在当前项目内"
        },
        "runtime_dir": {
          "type": "string",
          "description": "执行依赖与缓存目录，必须在当前项目内"
        },
        "state_dir": {
          "type": "string",
          "description": "用户数据目录；空字符串使用 ~/.redlotus",
          "allow_empty": true
        },
        "cleanup": {
          "type": "object",
          "description": "磁盘写满后是否清理已经关闭的旧会话与依赖缓存",
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "是否启用写满后的保守清理"
            },
            "execution_cache": {
              "type": "boolean",
              "description": "是否允许清理确认归属且不再活动的执行缓存"
            },
            "session_retention_days": {
              "type": "number",
              "description": "会话保留天数",
              "minimum": 0
            },
            "log_retention_days": {
              "type": "number",
              "minimum": 0,
              "description": "日志保留天数；0 关闭日志清理"
            },
            "session_log_max_bytes": {
              "type": "integer",
              "minimum": 1,
              "description": "单会话日志滚动的字节数，保留上一份日志"
            }
          },
          "required": [
            "enabled",
            "execution_cache",
            "session_retention_days",
            "log_retention_days",
            "session_log_max_bytes"
          ]
        }
      },
      "required": [
        "filename_max_chars",
        "file_lock_timeout_seconds",
        "project_dir",
        "sessions_dir",
        "project_logs_dir",
        "references_dir",
        "runtime_dir",
        "state_dir",
        "cleanup"
      ]
    },
    "input_limits": {
      "type": "object",
      "description": "全局和身份输入限制",
      "properties": {
        "csv_sniff_chars": {"type": "integer", "minimum": 1, "description": "CSV 分隔符探测最多读取的字符数；解析仍保留完整文件"},
        "max_redirects": {
          "type": "integer",
          "minimum": 0,
          "description": "远程引用和渠道附件最多跟随的 HTTP 重定向次数；0 表示不跟随"
        },
        "parse_concurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "一次输入内同时解析引用文件的数量；独立于子 Agent 线程额度"
        },
        "defaults": {
          "$ref": "#/$defs/input_limits",
          "required": [
            "max_files",
            "max_file_bytes",
            "reference_download_timeout_seconds"
          ]
        }
      },
      "required": [
        "csv_sniff_chars",
        "defaults",
        "parse_concurrency",
        "max_redirects"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/input_limits"
      }
    },
    "memory_perception": {
      "type": "object",
      "description": "记忆生产策略",
      "properties": {
        "model_role": {
          "type": "string",
          "description": "感知使用的 models 中的身份名称"
        },
        "window_turns": {
          "type": "integer",
          "description": "每次封窗的新增用户回合数",
          "minimum": 1
        },
        "overlap_turns": {
          "type": "integer",
          "description": "每窗引用前窗的重叠回合数",
          "minimum": 0
        },
        "quiescence_wait_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "清空记忆前等待当前生产空闲的秒数；超时只取消清空，不取消生产"
        }
      },
      "required": [
        "model_role",
        "window_turns",
        "overlap_turns",
        "quiescence_wait_timeout_seconds"
      ]
    },
    "short_term_memory": {
      "type": "object",
      "description": "项目记忆与检索配置",
      "properties": {
        "db_path": {
          "type": "string",
          "description": "LanceDB 路径；相对路径基于用户数据目录"
        },
        "table_name": {
          "type": "string",
          "description": "项目记忆基础表名"
        },
        "turn_token_limit": {
          "type": "integer",
          "description": "向量分块的 Token 上限",
          "minimum": 1
        },
        "turn_chunk_overlap_tokens": {
          "type": "integer",
          "description": "相邻分块重叠 Token 数",
          "minimum": 0
        },
        "vector_search_limit": {
          "type": "integer",
          "description": "向量召回候选数",
          "minimum": 1
        },
        "final_top_k": {
          "type": "integer",
          "description": "最终返回的记忆数",
          "minimum": 1
        },
        "min_similarity": {
          "type": "number",
          "description": "向量相似度下限"
        },
        "use_rerank": {
          "type": "boolean",
          "description": "是否调用重排模型"
        },
        "index": {
          "type": "object",
          "description": "向量索引参数",
          "properties": {
            "metric": {
              "type": "string",
              "description": "向量距离算法，例如 cosine、l2 或 dot"
            },
            "min_rows": {
              "type": "integer",
              "description": "创建向量索引的最少记录数",
              "minimum": 1
            },
            "rebuild_every_n_adds": {
              "type": "integer",
              "description": "新增多少行后重建向量索引",
              "minimum": 1
            },
            "rows_per_partition": {
              "type": "integer",
              "description": "每个向量分区的目标行数",
              "minimum": 1
            },
            "dimensions_per_sub_vector": {
              "type": "integer",
              "description": "每个子向量的维数",
              "minimum": 1
            }
          },
          "required": [
            "metric",
            "min_rows",
            "rebuild_every_n_adds",
            "rows_per_partition",
            "dimensions_per_sub_vector"
          ]
        }
      },
      "required": [
        "db_path",
        "table_name",
        "turn_token_limit",
        "turn_chunk_overlap_tokens",
        "vector_search_limit",
        "final_top_k",
        "min_similarity",
        "use_rerank",
        "index"
      ]
    },
    "long_term_memory": {
      "type": "object",
      "description": "长期记忆存储",
      "properties": {
        "table_name": {
          "type": "string",
          "description": "长期记忆基础表名"
        }
      },
      "required": [
        "table_name"
      ]
    },
    "model_metadata": {
      "type": "object",
      "description": "OpenRouter 模型元数据",
      "properties": {
        "url": {
          "type": "string",
          "description": "模型元数据 API 地址"
        },
        "timeout": {
          "type": "number",
          "description": "查询元数据的超时秒数",
          "exclusiveMinimum": 0
        },
        "supported_thinking_efforts": {
          "type": "array",
          "description": "允许使用的思考强度名称",
          "items": {
            "type": "string",
            "description": "思考强度"
          }
        }
      },
      "required": [
        "url",
        "timeout",
        "supported_thinking_efforts"
      ]
    },
    "rag_service": {
      "type": "object",
      "description": "向量与重排服务的传输策略",
      "properties": {
        "http2": {
          "type": "boolean",
          "description": "是否使用 HTTP/2"
        },
        "timeout": {
          "type": "number",
          "description": "请求超时秒数",
          "exclusiveMinimum": 0
        },
        "embedding_batch_size": {
          "type": "integer",
          "description": "每批 embedding 的条目数",
          "minimum": 1
        },
        "index_batch_size": {
          "type": "integer",
          "description": "每批索引更新的条目数",
          "minimum": 1
        }
      },
      "required": [
        "http2",
        "timeout",
        "embedding_batch_size",
        "index_batch_size"
      ]
    },
    "SILICONFLOW_BASE": {
      "type": [
        "string",
        "null"
      ],
      "description": "向量服务完整地址；可稍后配置"
    },
    "SILICONFLOW_KEY": {
      "type": [
        "string",
        "null"
      ],
      "description": "向量服务凭据，输入隐藏；可稍后配置"
    },
    "RAG_models": {
      "type": "object",
      "description": "向量模型选择；可稍后配置",
      "properties": {},
      "required": [],
      "additionalProperties": {
        "type": "string",
        "description": "模型名称"
      }
    },
    "bot": {
      "type": "object",
      "description": "渠道运行策略；启用机器人前显式配置，不影响纯 CLI 启动",
      "properties": {
        "agent_run_timeout_seconds": {
          "type": "number",
          "description": "渠道任务最长运行秒数",
          "exclusiveMinimum": 0
        },
        "send_reply_timeout_seconds": {
          "type": "number",
          "description": "渠道消息发送确认超时秒数，超时不自动重发",
          "exclusiveMinimum": 0
        },
        "reply_max_chars": {
          "type": "integer",
          "description": "单条回复字符上限",
          "exclusiveMinimum": 0
        },
        "session_idle_ttl_seconds": {
          "type": "number",
          "description": "空闲会话回收秒数，0 关闭回收",
          "minimum": 0
        },
        "session_gc_interval_seconds": {
          "type": "number",
          "description": "空闲会话扫描间隔秒数",
          "exclusiveMinimum": 0
        },
        "question_timeout_seconds": {
          "type": "number",
          "description": "等待渠道用户补充输入的秒数",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "agent_run_timeout_seconds",
        "send_reply_timeout_seconds",
        "reply_max_chars",
        "session_idle_ttl_seconds",
        "session_gc_interval_seconds",
        "question_timeout_seconds"
      ]
    },
    "image_generation": {
      "type": "object",
      "description": "图像服务传输、轮询和缺省工具参数",
      "properties": {
        "width": {"type": "integer", "minimum": 1, "description": "工具未指定时的图像宽度，须符合当前服务模型要求"},
        "height": {"type": "integer", "minimum": 1, "description": "工具未指定时的图像高度，须符合当前服务模型要求"},
        "max_wait_seconds": {"type": "number", "exclusiveMinimum": 0, "description": "图像提交、轮询及下载合计的最长等待秒数"},
        "http_timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "description": "图像服务单次 HTTP 操作的超时秒数"},
        "poll_interval_seconds": {"type": "number", "exclusiveMinimum": 0, "description": "图像任务未完成时的轮询间隔秒数"},
        "progress_every_polls": {"type": "integer", "minimum": 1, "description": "每经过多少次轮询显示一次等待进度"}
      },
      "required": ["width", "height", "max_wait_seconds", "http_timeout_seconds", "poll_interval_seconds", "progress_every_polls"]
    },
    "ui": {
      "type": "object",
      "description": "终端展示策略；不裁剪正式会话或审查记录",
      "properties": {
        "status_refresh_seconds": {"type": "number", "exclusiveMinimum": 0, "description": "运行状态刷新的间隔秒数"},
        "panel_refresh_seconds": {"type": "number", "exclusiveMinimum": 0, "description": "用量面板刷新的间隔秒数"},
        "max_diff_lines": {"type": "integer", "minimum": 1, "description": "彩色 diff 预览最多显示的行数；截断时显示剩余数量"},
        "stream_preview_max_lines": {"type": "integer", "minimum": 1, "description": "流式正文预览最多保留的末尾行数；不裁剪完整回复"},
        "stream_preview_max_chars": {"type": "integer", "minimum": 1, "description": "流式正文预览最多保留的末尾字符数；不裁剪完整回复"},
        "recent_session_limit": {"type": "integer", "minimum": 1, "description": "用量面板默认展示的最近会话数量；全部模式不限制"},
        "max_skipped_files": {"type": "integer", "minimum": 1, "description": "面板展示的损坏会话文件明细上限；失败总数仍完整统计"},
        "file_completion_limit": {"type": "integer", "minimum": 1, "description": "路径输入补全最多展示的候选数量，目录仍排在文件之前"},
        "tool_argument_preview_chars": {"type": "integer", "minimum": 1, "description": "每个工具参数在通知中的字符上限；不改模型实际参数"},
        "tool_keyword_limit": {"type": "integer", "minimum": 1, "description": "工具通知最多展示的命名参数数量"},
        "tool_positional_limit": {"type": "integer", "minimum": 1, "description": "工具通知最多展示的位置参数数量"},
        "usage_file_limit": {"type": "integer", "minimum": 1, "description": "用量报告最多展示的源文件路径数量；累计数值和文件总数不受限制"},
        "session_error_max_chars": {"type": "integer", "minimum": 1, "description": "会话加载菜单的失败原因字符上限；完整原因仍保留在记录中"}
      },
      "required": ["status_refresh_seconds", "panel_refresh_seconds", "max_diff_lines", "stream_preview_max_lines", "stream_preview_max_chars", "recent_session_limit", "max_skipped_files", "file_completion_limit", "tool_argument_preview_chars", "tool_keyword_limit", "tool_positional_limit", "usage_file_limit", "session_error_max_chars"]
    },
    "web_search": {
      "type": "object",
      "description": "搜索工具的等待和原生 DDGS 参数；显式工具数量参数可覆盖本次请求",
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "description": "搜索服务 HTTP 操作等待秒数"},
        "max_results": {"type": "integer", "minimum": 1, "description": "工具未指定时的搜索结果数量"},
        "region": {"type": "string", "description": "DDGS 搜索区域，例如 cn-zh 或 wt-wt"},
        "safesearch": {"type": "string", "string_values": ["on", "moderate", "off"], "description": "DDGS 内容过滤级别"},
        "timelimit": {"type": ["string", "null"], "description": "DDGS 搜索时间范围；null 表示不限制"},
        "backend": {"type": "string", "description": "DDGS 搜索后端；auto 由原生库选择，可按库支持指定后端"}
      },
      "required": ["timeout_seconds", "max_results", "region", "safesearch", "timelimit", "backend"]
    },
    "BROWSER_HEADLESS": {
      "type": ["boolean", "string", "integer"],
      "minimum": 0,
      "maximum": 1,
      "string_values": ["true", "false", "1", "0", "yes", "no"],
      "description": "浏览器是否无窗口运行；兼容原 BROWSER_HEADLESS 配置键，缺失时明确填写"
    },
    "browser": {
      "type": "object",
      "description": "浏览器操作等待策略",
      "properties": {
        "viewport": {
          "type": "object",
          "description": "浏览器页面视口像素大小",
          "properties": {
            "width": {"type": "integer", "minimum": 1, "description": "页面视口宽度（像素）"},
            "height": {"type": "integer", "minimum": 1, "description": "页面视口高度（像素）"}
          },
          "required": ["width", "height"]
        },
        "locale": {
          "type": "string",
          "description": "浏览器区域语言，例如 zh-CN 或 en-US"
        },
        "action_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "浏览器读取、点击、填写和选择器等待的默认秒数"
        },
        "navigation_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "浏览器页面导航的默认等待秒数"
        }
      },
      "required": [
        "viewport",
        "locale",
        "action_timeout_seconds",
        "navigation_timeout_seconds"
      ]
    }
  },
  "required": [
    "models",
    "MODEL_HTTP_TIMEOUT",
    "request_limit",
    "agent_run_policy",
    "lifecycle",
    "storage",
    "input_limits",
    "memory_perception",
    "short_term_memory",
    "long_term_memory",
    "model_metadata",
    "rag_service",
    "browser",
    "BROWSER_HEADLESS",
    "ui",
    "image_generation",
    "web_search"
  ],
  "$defs": {
    "model": {
      "type": [
        "object",
        "string"
      ],
      "description": "模型对象或已命名的预设",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ],
          "description": "SDK 的 服务:模型 标识；输入 =已配置角色 复用模型名，连接与策略保持当前角色配置"
        },
        "preset": {
          "type": "string",
          "description": "已有 model_presets 中的名称"
        },
        "gateway": {
          "type": "string",
          "description": "已有 gateways 中的名称；未指定时使用 BASE_URL / API_KEY"
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "description": "模型最大输出 Token，null 由服务决定",
          "minimum": 1
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ],
          "description": "服务支持的采样温度"
        },
        "top_p": {
          "type": [
            "number",
            "null"
          ],
          "description": "服务支持的 top_p"
        },
        "thinking": {
          "type": "string",
          "description": "模型思考开关，例如 enabled 或 disabled"
        },
        "reasoning_effort": {
          "type": "string",
          "description": "模型支持的思考强度"
        },
        "max_context_windows": {
          "type": [
            "integer",
            "null"
          ],
          "description": "模型上下文容量；缺失或 null 时查询 OpenRouter metadata，只在 config.json 编辑",
          "minimum": 1,
          "config_only": true
        },
        "auto_compress_ratio": {
          "type": "number",
          "description": "按服务端输入 Token 触发自动压缩的容量比例",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "compress_head_turns": {
          "type": "integer",
          "description": "压缩时保留的开头用户回合数",
          "minimum": 0
        },
        "compress_tail_turns": {
          "type": "integer",
          "description": "压缩时保留的末尾用户回合数",
          "minimum": 0
        },
        "settings": {
          "$ref": "#/$defs/model_settings"
        }
      },
      "required": [
        "name"
      ]
    },
    "context_model": {
      "$ref": "#/$defs/model",
      "required": [
        "name",
        "auto_compress_ratio",
        "compress_head_turns",
        "compress_tail_turns"
      ]
    },
    "model_settings": {
      "$ref": "#/$defs/model",
      "type": "object",
      "required": [],
      "description": "模型设置的可选嵌套写法，共用模型字段类型"
    },
    "input_limits": {
      "type": "object",
      "description": "发送前的文件与请求边界",
      "properties": {
        "max_files": {
          "type": "integer",
          "description": "单次输入最多文件数",
          "minimum": 1
        },
        "max_file_bytes": {
          "type": "integer",
          "description": "单个文件最大字节数",
          "minimum": 1
        },
        "max_request_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "description": "编码后请求最大字节数，null 表示未声明",
          "minimum": 1
        },
        "reference_download_timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "远程引用下载的 HTTP 超时秒数，可由网关和角色覆盖"
        }
      },
      "required": [
        "max_files",
        "max_file_bytes"
      ]
    }
  }
}
