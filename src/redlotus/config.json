{
  "BASE_URL": "",
  "API_KEY": "",
  "SILICONFLOW_BASE": "",
  "SILICONFLOW_KEY": "",
  "RAG_models": {
    "embedding": "Qwen/Qwen3-Embedding-0.6B",
    "reranker": "Qwen/Qwen3-Reranker-0.6B"
  },
  "models": {
    "manager": {
      "name": "deepseek:deepseek-v4-flash",
      "temperature": 1.0,
      "max_tokens": 393216,
      "top_p": 1.0,
      "reasoning_effort": "max",
      "thinking": "enabled",
      "auto_compress_ratio": 0.9,
      "compress_tail_turns": 2,
      "compress_head_turns": 2
    },
    "worker": {
      "name": "deepseek:deepseek-v4-flash",
      "temperature": 1.0,
      "max_tokens": 393216,
      "top_p": 1.0,
      "reasoning_effort": "max",
      "thinking": "enabled",
      "auto_compress_ratio": 0.9,
      "compress_tail_turns": 2,
      "compress_head_turns": 2
    },
    "coordinator": {
      "name": "deepseek:deepseek-v4-flash",
      "temperature": 1.0,
      "max_tokens": 393216,
      "top_p": 1.0,
      "reasoning_effort": "max",
      "thinking": "enabled",
      "auto_compress_ratio": 0.9,
      "compress_tail_turns": 2,
      "compress_head_turns": 2
    },
    "compressor": {
      "name": "deepseek:deepseek-v4-flash",
      "temperature": 0.2,
      "max_tokens": 131072,
      "top_p": 1.0,
      "reasoning_effort": "max",
      "thinking": "enabled"
    },
    "title": {
      "name": "deepseek:deepseek-v4-flash",
      "temperature": 1.0,
      "max_tokens": 393216,
      "top_p": 1.0,
      "thinking": "disabled"
    }
  },
  "lifecycle": {
    "invocation_history_per_session": 50,
    "shutdown_grace_seconds": 3
  },
  "short_term_memory": {
    "db_path": "data/rag_lancedb/stm",
    "table_name": "conversation_turns",
    "vector_search_limit": 30,
    "final_top_k": 8,
    "use_rerank": true,
    "min_similarity": 0.3,
    "turn_token_limit": 8192,
    "turn_chunk_overlap_tokens": 512,
    "index": {
      "min_rows": 256,
      "metric": "cosine",
      "rebuild_every_n_adds": 100,
      "rows_per_partition": 4096,
      "dimensions_per_sub_vector": 8
    }
  },
  "long_term_memory": {
    "table_name": "semantic_memories"
  },
  "request_limit": null,
  "MODEL_HTTP_TIMEOUT": 300,
  "memory_perception": {
    "window_turns": 20,
    "overlap_turns": 3,
    "model_role": "worker"
  },
  "input_limits": {
    "defaults": {
      "max_file_bytes": 20000000,
      "max_files": 20,
      "max_request_bytes": null
    }
  },
  "model_metadata": {
    "url": "https://openrouter.ai/api/v1/models",
    "timeout": 15,
    "supported_thinking_efforts": [
      "minimal",
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ]
  },
  "rag_service": {
    "timeout": 60,
    "http2": true,
    "embedding_batch_size": 32,
    "index_batch_size": 32
  },
  "agent_run_policy": {
    "max_concurrent_threads_per_session": 16,
    "max_command_timeout_seconds": 60
  },
  "storage": {
    "state_dir": "~/.redlotus",
    "project_dir": ".redlotus",
    "sessions_dir": ".redlotus/sessions",
    "project_logs_dir": ".redlotus/logs",
    "references_dir": "WorkDatabase/references",
    "runtime_dir": "WorkDatabase/runtime",
    "cleanup": {
      "enabled": true,
      "session_retention_days": 7,
      "execution_cache": true
    }
  }
}
