{
  "BASE_URL": "",
  "API_KEY": "",
  "SILICONFLOW_BASE": "",
  "SILICONFLOW_KEY": "",
  "storage": {
    "state_dir": null,
    "sessions_dir": null,
    "references_dir": null,
    "compression_dir": null,
    "runtime_dir": null
  },
  "model_gateway": {
    "protocol": "openai-chat",
    "connect_timeout": 10,
    "settings": {
      "parallel_tool_calls": true
    }
  },
  "model_metadata": {
    "url": "https://openrouter.ai/api/v1/models",
    "timeout": 15,
    "supported_thinking_efforts": [
      "minimal",
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ]
  },
  "rag_service": {
    "timeout": 60,
    "http2": true,
    "embedding_batch_size": 32,
    "index_batch_size": 32,
    "query_instruction": "Instruct: Retrieve related project goals, decisions and outcomes.\nQuery: "
  },
  "RAG_models": {
    "embedding": "Qwen/Qwen3-Embedding-0.6B",
    "reranker": "Qwen/Qwen3-Reranker-0.6B"
  },
  "models": {
    "manager": {
      "name": "deepseek-v4-flash",
      "temperature": 1.0,
      "max_tokens": 393216,
      "top_p": 1.0,
      "reasoning_effort": "max",
      "thinking": "enabled"
    },
    "worker": {
      "name": "deepseek-v4-flash",
      "temperature": 1.0,
      "max_tokens": 393216,
      "top_p": 1.0,
      "reasoning_effort": "max",
      "thinking": "enabled"
    },
    "coordinator": {
      "name": "deepseek-v4-flash",
      "temperature": 1.0,
      "max_tokens": 393216,
      "top_p": 1.0,
      "reasoning_effort": "max",
      "thinking": "enabled"
    },
    "compressor": {
      "name": "deepseek-v4-flash",
      "temperature": 0.2,
      "max_tokens": 16384,
      "top_p": 1.0,
      "reasoning_effort": "max",
      "thinking": "enabled"
    },
    "title": {
      "name": "deepseek-v4-flash",
      "temperature": 1.0,
      "max_tokens": 393216,
      "top_p": 1.0,
      "thinking": "disabled"
    }
  },
  "context": {
    "defaults": {},
    "compression": {
      "middle_tool_args_max_chars": 1200
    },
    "coordinator": {
      "max_context_tokens": null,
      "default_context_tokens": 393216,
      "auto_compress_ratio": 0.8,
      "tail_turns": 2,
      "head_turns": 2
    },
    "manager": {
      "max_context_tokens": null,
      "default_context_tokens": 393216,
      "auto_compress_ratio": 0.8,
      "tail_turns": 2,
      "head_turns": 2
    },
    "worker": {
      "max_context_tokens": null,
      "default_context_tokens": 393216,
      "auto_compress_ratio": 0.8,
      "tail_turns": 2,
      "head_turns": 2
    },
    "title": {
      "max_context_tokens": null,
      "default_context_tokens": 393216,
      "auto_compress_ratio": 0.8,
      "tail_turns": 2,
      "head_turns": 2
    }
  },
  "bot": {
    "session_queue_maxsize": 50,
    "owner_channels": {
      "qq": [],
      "wechat": []
    }
  },
  "conversation_log": {
    "save_model_thinking_chain": true
  },
  "lifecycle": {
    "invocation_history_per_session": 50,
    "shutdown_grace_seconds": 3
  },
  "agent_run_policy": {
    "max_concurrent_threads_per_session": 16,
    "max_tool_output_chars": 20000,
    "max_command_timeout_seconds": 60
  },
  "short_term_memory": {
    "db_path": "data/rag_lancedb/stm",
    "table_name": "conversation_turns",
    "vector_search_limit": 30,
    "final_top_k": 8,
    "use_rerank": true,
    "min_similarity": 0.3,
    "turn_token_limit": 8192,
    "turn_chunk_overlap_tokens": 512,
    "index": {
      "min_rows": 256,
      "metric": "cosine",
      "rows_per_partition": 4096,
      "dimensions_per_sub_vector": 8,
      "rebuild_every_n_adds": 100
    }
  },
  "long_term_memory": {
    "table_name": "semantic_memories"
  },
  "request_limit": null,
  "MODEL_HTTP_TIMEOUT": 300,
  "memory_perception": {
    "window_turns": 20,
    "overlap_turns": 3,
    "model_role": "worker",
    "input_context_ratio": 0.65,
    "existing_record_limit": 12,
    "query_max_chars": 1200,
    "evidence_read_tokens": 12000
  },
  "input_limits": {
    "defaults": {
      "max_files": 20,
      "max_file_bytes": 20000000,
      "max_request_bytes": null
    }
  },
  "task_title": {
    "max_chars": 50
  },
  "execution": {
    "output_encodings": ["utf-8-sig", "locale"],
    "python_executable": "",
    "environment_dir": "{runtime}/environments/{project_id}",
    "cache_dir": "{runtime}/cache",
    "inherit_env": [
      "PATH",
      "SystemRoot",
      "WINDIR",
      "COMSPEC",
      "PATHEXT",
      "SYSTEMDRIVE",
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "NO_PROXY",
      "PLAYWRIGHT_BROWSERS_PATH",
      "CLAWHUB_WORKDIR",
      "HOME",
      "USERPROFILE",
      "APPDATA",
      "LOCALAPPDATA",
      "HOMEDRIVE",
      "HOMEPATH",
      "XDG_CONFIG_HOME",
      "SSH_AUTH_SOCK",
      "SSH_AGENT_PID",
      "GIT_CONFIG_GLOBAL",
      "GIT_CONFIG_SYSTEM",
      "GIT_SSH",
      "GIT_SSH_COMMAND",
      "NPM_CONFIG_USERCONFIG",
      "npm_config_userconfig"
    ],
    "permissions": {
      "restricted_roles": [
        "worker",
        "manager"
      ],
      "blocked_commands": [
        "kill",
        "pkill",
        "killall",
        "taskkill",
        "tskill",
        "stop-process",
        "spps",
        "shutdown",
        "restart-computer",
        "stop-computer",
        "stop-service",
        "restart-service"
      ],
      "script_extensions": [
        ".py",
        ".pyw",
        ".ps1",
        ".sh",
        ".bat",
        ".cmd",
        ".js",
        ".mjs",
        ".cjs"
      ],
      "blocked_python_calls": [
        "os.kill",
        "os.killpg",
        "signal.pthread_kill",
        "psutil.Process.kill",
        "psutil.Process.terminate",
        "subprocess.Popen.kill",
        "subprocess.Popen.terminate",
        "multiprocessing.Process.kill",
        "multiprocessing.Process.terminate"
      ],
      "command_wrappers": [
        "subprocess.run",
        "subprocess.call",
        "subprocess.check_call",
        "subprocess.check_output",
        "subprocess.Popen",
        "os.system",
        "os.popen",
        "asyncio.create_subprocess_exec",
        "asyncio.create_subprocess_shell"
      ],
      "blocked_script_patterns": [
        "\\bprocess\\s*\\.\\s*kill\\s*\\(",
        "\\b(?:TerminateProcess|NtTerminateProcess|TerminateJobObject)\\s*\\("
      ],
      "blocked_shell_options": [
        "-encodedcommand",
        "-enc",
        "-ec"
      ],
      "background_commands": [
        "start",
        "nohup",
        "setsid",
        "start-process"
      ]
    },
    "variables": {
      "PIP_CACHE_DIR": "{cache}/{project_id}/pip",
      "npm_config_cache": "{cache}/{project_id}/npm",
      "UV_CACHE_DIR": "{cache}/{project_id}/uv",
      "XDG_CACHE_HOME": "{cache}/{project_id}/xdg",
      "TEMP": "{cache}/{project_id}/tmp",
      "TMP": "{cache}/{project_id}/tmp",
      "TMPDIR": "{cache}/{project_id}/tmp",
      "PYTHONNOUSERSITE": "1",
      "PYTHONUTF8": "1",
      "PIP_DISABLE_PIP_VERSION_CHECK": "1"
    }
  }
}
