diff --git a/include/GPTSoVITS/Utils/MamboDecoder.h b/include/GPTSoVITS/Utils/MamboDecoder.h
new file mode 100644
--- /dev/null
+++ b/include/GPTSoVITS/Utils/MamboDecoder.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <algorithm>
+#include <cstring>
+#include <functional>
+
+#include "GPTSoVITS/model/base.h"
+#include "GPTSoVITS/Utils/MamboSampling.h"
+
+namespace GPTSoVITS::Utils {
+
+class MamboDecoder {
+  Model::BaseModel& encoder_;
+  Model::BaseModel& step_;
+  int capacity_;
+ public:
+  MamboDecoder(Model::BaseModel& encoder, Model::BaseModel& step, int capacity)
+      : encoder_(encoder), step_(step), capacity_(capacity) {}
+
+  std::unique_ptr<Model::Tensor> Generate(Model::Tensor* phones, Model::Tensor* prompt,
+      Model::Tensor* features, const Model::SampleConfig& config, Model::InferStats* stats,
+      const std::function<void(const std::vector<int64_t>&, bool)>& observer = {}) {
+    using Outputs = std::unordered_map<std::string, std::unique_ptr<Model::Tensor>>;
+    Outputs outputs;
+    encoder_.Forward({{"phoneme_ids", phones}, {"prompts", prompt}, {"bert_feature", features}}, outputs);
+    auto keys = std::move(outputs.at("k_cache"));
+    auto values = std::move(outputs.at("v_cache"));
+    auto x_len = std::move(outputs.at("x_len"));
+    auto y_len = std::move(outputs.at("y_len"));
+    const auto context = x_len->At<int64_t>(0) + y_len->At<int64_t>(0);
+    if (keys->Shape() != values->Shape() || keys->Shape().size() != 4 || keys->Shape()[2] != context)
+      throw std::invalid_argument("Mambo CPU package requires growing KV cache graphs");
+    const auto limit = std::min<int64_t>(1000, capacity_ - context - 1);
+    if (limit < 11) throw std::invalid_argument("Mambo text exceeds decoder capacity");
+    auto sample = Model::Tensor::Empty({1, 1}, Model::DataType::kInt64, Model::DeviceType::kCPU);
+    auto index = Model::Tensor::Empty({1}, Model::DataType::kInt64, Model::DeviceType::kCPU);
+    MamboSampling sampler(prompt, config);
+    std::vector<int64_t> tokens;
+    bool ended = false;
+    for (int64_t i = 0; i < limit; ++i) {
+      const auto token = sampler.Sample(outputs.at("topk_values").get(), outputs.at("topk_indices").get());
+      if (token == 1024) { ended = true; break; }
+      tokens.push_back(token);
+      if (observer) observer(tokens, false);
+      sample->At<int64_t>(0) = token;
+      index->At<int64_t>(0) = i;
+      Outputs next;
+      step_.Forward({{"samples", sample.get()}, {"k_cache", keys.get()}, {"v_cache", values.get()},
+                     {"x_len", x_len.get()}, {"y_len", y_len.get()}, {"idx", index.get()}}, next);
+      keys = std::move(next.at("k_cache_new"));
+      values = std::move(next.at("v_cache_new"));
+      outputs = std::move(next);
+    }
+    if (!ended || tokens.empty()) throw std::runtime_error("Mambo semantic generation did not finish within its limit");
+    if (observer) observer(tokens, true);
+    if (stats) stats->gpt_tokens += static_cast<int>(tokens.size());
+    auto result = Model::Tensor::Empty({1, 1, static_cast<int64_t>(tokens.size())},
+                                      Model::DataType::kInt64, Model::DeviceType::kCPU);
+    std::memcpy(result->Data(), tokens.data(), tokens.size() * sizeof(int64_t));
+    return result;
+  }
+};
+
+}  // namespace GPTSoVITS::Utils
diff --git a/include/GPTSoVITS/Utils/MamboSampling.h b/include/GPTSoVITS/Utils/MamboSampling.h
new file mode 100644
--- /dev/null
+++ b/include/GPTSoVITS/Utils/MamboSampling.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include <array>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+#include "GPTSoVITS/Utils/Sampling.h"
+#include "GPTSoVITS/model/sample_config.h"
+
+namespace GPTSoVITS::Utils {
+
+// Matches the pinned v2 recipe: full logits, prompt repetition penalty and EOS floor.
+class MamboSampling {
+  std::array<bool, 1025> seen_{};
+  std::unique_ptr<Model::Tensor> logits_;
+  SamplingConfig config_;
+  Sampler sampler_;
+  int generated_ = 0;
+
+public:
+  MamboSampling(const Model::Tensor* prompt, const Model::SampleConfig& config)
+      : logits_(Model::Tensor::Empty({1, 1025}, Model::DataType::kFloat32, Model::DeviceType::kCPU)) {
+    config_.strategy = SamplingStrategy::kTopKTopP;
+    config_.top_k = config.top_k;
+    config_.top_p = config.top_p;
+    config_.temperature = config.temperature;
+    if (!config_.Validate()) throw std::invalid_argument("Invalid Mambo sampling configuration");
+    sampler_.SetSeed(42);
+    auto values = prompt->To(Model::DeviceType::kCPU, Model::DataType::kInt64);
+    for (int64_t i = 0; i < values->ElementCount(); ++i) {
+      const auto token = values->Data<int64_t>()[i];
+      if (token < 0 || token >= 1024) throw std::invalid_argument("Invalid reference semantic token");
+      seen_[token] = true;
+    }
+  }
+
+  int64_t Sample(const Model::Tensor* scores, const Model::Tensor* ids) {
+    if (!scores || !ids || scores->ElementCount() != 1025 || ids->ElementCount() != 1025)
+      throw std::invalid_argument("Mambo requires the complete semantic vocabulary");
+    auto values = scores->To(Model::DeviceType::kCPU, Model::DataType::kFloat32);
+    auto indices = ids->To(Model::DeviceType::kCPU, Model::DataType::kInt64);
+    if (generated_ >= 11 && indices->Data<int64_t>()[0] == 1024) return 1024;
+    std::array<bool, 1025> found{};
+    auto* logits = logits_->Data<float>();
+    for (int i = 0; i < 1025; ++i) {
+      const int64_t token = indices->Data<int64_t>()[i];
+      const float value = values->Data<float>()[i];
+      if (token < 0 || token >= 1025 || found[token] || !std::isfinite(value))
+        throw std::invalid_argument("Invalid Mambo semantic scores");
+      found[token] = true;
+      logits[token] = seen_[token] ? (value < 0 ? value * 1.35f : value / 1.35f) : value;
+    }
+    if (generated_ < 11) logits[1024] = -std::numeric_limits<float>::infinity();
+    const auto token = sampler_.Sample(logits_.get(), config_);
+    seen_[token] = true;
+    ++generated_;
+    return token;
+  }
+};
+
+}  // namespace GPTSoVITS::Utils
