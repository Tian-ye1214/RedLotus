+    static std::mutex guard;
+    static std::weak_ptr<SharedCpuArena> current;
+    std::lock_guard<std::mutex> lock(guard);
+    auto arena = current.lock();
+    if (!arena) {
+      arena = std::make_shared<SharedCpuArena>(threads);
+      current = arena;
+    }
+    return arena;
